# Stack profile: Python
STACK_NAME=Python
LINT_CMD=ruff check .
TYPECHECK_CMD=mypy .
FORMAT_CMD=ruff format .
FORMAT_CHECK_CMD=ruff format --check .
TEST_CMD=pytest -q
TEST_ONE_CMD=pytest -q <path>
BUILD_CMD=
RUN_CMD=
DEP_DIRS=.venv
LOCAL_ONLY_FILES=.env
BASE_BRANCH=main
NOTES=Typed signatures at module boundaries. Pin deps via the lockfile; never `pip install` ad hoc inside a worktree.
